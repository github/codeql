- description: Security-and-quality queries for C and C++
- queries: .
- apply: security-and-frozen-quality-selectors.yml
  from: codeql/suite-helpers
- include:
    id:
      - cpp/ambiguous-assignment-of-comparison
      - cpp/ambiguously-signed-bit-field
      - cpp/array-arg-size-mismatch
      - cpp/array-in-interface
      - cpp/assign-where-compare-meant
      - cpp/assignment-does-not-return-this
      - cpp/bitwise-sign-check
      - cpp/catch-by-value
      - cpp/catch-missing-free
      - cpp/commented-out-code
      - cpp/compare-where-assign-meant
      - cpp/comparison-of-identical-expressions
      - cpp/comparison-precedence
      - cpp/complex-block
      - cpp/complex-condition
      - cpp/constant-comparison
      - cpp/constructor-delegation
      - cpp/continue-in-false-loop
      - cpp/dead-code-goto
      - cpp/declaration-hides-parameter
      - cpp/declaration-hides-variable
      - cpp/dubious-null-check
      - cpp/duplicate-include-guard
      - cpp/empty-block
      - cpp/empty-if
      - cpp/equality-on-floats
      - cpp/fixme-comment
      - cpp/function-in-block
      - cpp/futile-params
      - cpp/guarded-free
      - cpp/implicit-bitfield-downcast
      - cpp/implicit-function-declaration
      - cpp/include-non-header
      - cpp/incomplete-parity-check
      - cpp/inconsistent-call-on-result
      - cpp/inconsistent-loop-direction
      - cpp/inconsistent-null-check
      - cpp/inconsistent-virtual-inheritance
      - cpp/integer-used-for-enum
      - cpp/irregular-enum-init
      - cpp/large-parameter
      - cpp/leap-year/adding-365-days-per-year
      - cpp/leap-year/unchecked-after-arithmetic-year-modification
      - cpp/leap-year/unchecked-return-value-for-time-conversion-function
      - cpp/local-variable-hides-global-variable
      - cpp/logical-operator-applied-to-flag
      - cpp/long-switch
      - cpp/loop-variable-changed
      - cpp/loop-variable-float
      - cpp/lossy-function-result-cast
      - cpp/lossy-pointer-cast
      - cpp/member-const-no-effect
      - cpp/missing-case-in-switch
      - cpp/missing-header-guard
      - cpp/missing-return
      - cpp/mistyped-function-arguments
      - cpp/nested-loops-with-same-variable
      - cpp/new-array-delete-mismatch
      - cpp/new-delete-array-mismatch
      - cpp/non-member-const-no-effect
      - cpp/poorly-documented-function
      - cpp/redefined-default-parameter
      - cpp/resource-not-released-in-destructor
      - cpp/rethrow-no-exception
      - cpp/return-c-str-of-std-string
      - cpp/rule-of-two
      - cpp/short-global-name
      - cpp/sizeof-side-effect
      - cpp/slicing
      - cpp/stack-address-escape
      - cpp/string-copy-return-value-as-boolean
      - cpp/throw-in-destructor
      - cpp/throwing-pointer
      - cpp/too-many-format-arguments
      - cpp/trivial-switch
      - cpp/undisciplined-multiple-inheritance
      - cpp/unsigned-comparison-zero
      - cpp/unused-local-variable
      - cpp/unused-static-function
      - cpp/unused-static-variable
      - cpp/use-in-own-initializer
      - cpp/use-of-goto
      - cpp/useless-expression
      - cpp/virtual-call-in-constructor
      - cpp/virtual-destructor
- apply: codeql-suites/exclude-slow-queries.yml
