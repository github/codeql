      "data": [
        // path-injection
        ["github.com/labstack/echo", "Context", true, "Attachment", "", "", "Argument[0]", "path-injection", "manual"],
        ["github.com/labstack/echo", "Context", true, "File", "", "", "Argument[0]", "path-injection", "manual"],
