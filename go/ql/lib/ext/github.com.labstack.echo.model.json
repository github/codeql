        ["github.com/labstack/echo", "Context", true, "Redirect", "", "", "Argument[1]", "url-redirection", "manual"]
      ]
    },
    {
      "addsTo": {
        "pack": "codeql/go-all",
        "extensible": "summaryModel"
      },
      "data": [
        ["github.com/labstack/echo", "Context", true, "Get", "", "", "Argument[receiver]", "ReturnValue", "taint", "manual"],
