import "../justfile"

# A whole language test suite is slow, so it only runs when asked for by name.
explicit_verbs := ['test']

base_flags := _python_env

all_checks := default_db_checks ++ ['--consistency-queries=' + consistency_queries]

[no-cd]
test *ARGS=".": (_codeql_test "python" (base_flags ++ prepend('--extra-check=', all_checks) ++ ARGS))
