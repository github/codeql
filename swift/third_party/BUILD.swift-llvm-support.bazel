load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(
    name = "swift-llvm-support-static",
    srcs = glob(
        [
            "*.a",
        ],
    ),
    hdrs = glob([
        "include/**/*",
        "stdlib/**/*",
    ]),
    includes = [
        "include",
        "stdlib/public/SwiftShims",
    ],
    deps = [
        "@zstd",
    ],
)

filegroup(
    name = "swift-llvm-support-shared",
    srcs = glob(
        [
            "*.so",
            "*.dylib",
        ],
        allow_empty = True,  # Either *.so or *.dylib will be empty
    ),
    visibility = ["//visibility:public"],
)

cc_library(
    name = "swift-llvm-support",
    srcs = [":swift-llvm-support-shared"],
    linkopts = [
        "-lm",
        "-lz",
    ] + select({
        "@platforms//os:linux": [
            "-luuid",
            "-lrt",
            "-lpthread",
            "-ldl",
        ],
        "@platforms//os:macos": [
            "-L/usr/lib/swift",
        ],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [":swift-llvm-support-static"],
)
