{
  "compilerOptions": {
      "module": "nodenext",
      "noImplicitAny": true,
      "removeComments": true,
      "sourceMap": false,
      "lib": ["es2022", "esnext.disposable"],
      "types": ["node"],
      "target": "es2022",
      "rootDir": "src",
      "outDir": "build",
      "allowJs": true,
  },
  "include": [
    "src"
  ]
}
