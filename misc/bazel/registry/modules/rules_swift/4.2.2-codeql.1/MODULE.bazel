    },
)

[
    apt.ubuntu(
        name = "swift_ubuntu{}_{}_sysroot".format(version, arch),
        architectures = [arch],
        glob_excludes = ["usr/share/man/**"],
        lockfile = "//swift/internal/extensions:ubuntu{}_{}_sysroot.lock.json".format(version, arch),
        # Supplies the /lib symlink required by libc's linker scripts on 24.04+.
        packages = (["base-files"] if version != "22.04" else []) + [
            "libc6-dev",
            "libcurl4-openssl-dev",
            "libstdc++-{}-dev".format(gcc),
            "libxml2-dev",
            "linux-libc-dev",
            "zlib1g-dev",
        ],
        suites = [suite],
        uri = "https://snapshot.ubuntu.com/ubuntu/20261001T000000Z",
    )
    for version, suite, gcc in [
        ("22.04", "jammy", "11"),
        ("24.04", "noble", "13"),
        ("26.04", "resolute", "15"),
    ]
    for arch in [
        "amd64",
        "arm64",
    ]
]

