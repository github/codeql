CodeQL still builds extractors with Kotlin 1.8 and 1.9 language/API versions.
Keep those supported and keep the API version aligned with the language version.
--- a/src/main/starlark/core/options/opts.kotlinc.bzl
+++ b/src/main/starlark/core/options/opts.kotlinc.bzl
@@ -93,9 +93,7 @@
 def _map_language_version_to_flag(version):
     if not version:
         return None
-    if int(version.split(".")[0]) < 2:
-        fail("rules_kotlin requires language_version 2.0 or newer; got %s" % version)
-    return ["-language-version=%s" % version]
+    return ["-language-version=%s" % version, "-api-version=%s" % version]
 
 def _map_xxlanguage_to_flag(values):
     return ["-XXLanguage:%s" % v for v in values]
