<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <Target Name="CheckMSBuildServer">
    <Error Condition="'$(DOTNET_CLI_USE_MSBUILD_SERVER)' != 'false'"
           Text="Expected the .NET CLI MSBuild server to be disabled during CodeQL tracing." />
  </Target>

</Project>
