<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <Target Name="CheckNodeReuse">
    <Error Condition="'$(MSBUILDDISABLENODEREUSE)' != '1'"
           Text="Expected MSBuild node reuse to be disabled during CodeQL tracing." />
  </Target>

</Project>
