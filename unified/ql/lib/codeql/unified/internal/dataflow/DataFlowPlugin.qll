/**
 * Provides an interface for language-specific data flow rules.
 */

private import unified
private import AllDataFlow
private import codeql.util.Unit

private module Plugins {
  private import DataFlowPluginSwift
}

class DataFlowPlugin extends Unit {
  /**
   * Holds if there is flow from `expr1` to `expr2` and the post-updated value of `expr2` (if any) should propagate back to
   * the post-update for `expr1`.
   */
  predicate exprStep(Expr expr1, Expr expr2, boolean mustFlow) { none() }

  /** Holds if there is a language-specific step from `node1 -> step -> node2`. */
  predicate step(BuilderNode node1, Step step, BuilderNode node2) { none() }

  /**
   * Holds if a read/store step with the given `contents` should be converted to a value step.
   *
   * This affects the steps generated by the language-agnostic code as well as steps from the plugin itself.
   */
  predicate bypassContentSet(ContentSet contents) { none() }

  /**
   * Holds if mutating the value of `expr` in-place, such as `expr.f = y` or `expr.mutate()`,
   * may cause the mutated value to be written back via a setter call.
   *
   * `expr` is an expression in getter position, such as a member access.
   */
  bindingset[expr]
  predicate mayWriteBackViaSetterCall(Expr expr) { none() }
}

/**
 * Holds if a read/store step with the given `contents` should be converted to a value step.
 */
predicate bypassContentSet(ContentSet contents) { any(DataFlowPlugin p).bypassContentSet(contents) }

/**
 * Holds if there is flow from `expr1` to `expr2` and the post-updated value of `expr2` (if any) should propagate back to
 * the post-update for `expr1`.
 */
predicate exprStep(Expr expr1, Expr expr2, boolean mustFlow) {
  any(DataFlowPlugin p).exprStep(expr1, expr2, mustFlow)
}

/**
 * Holds if mutating the value of `expr` in-place, such as `expr.f = y` or `expr.mutate()`,
 * may cause the mutated value to be written back via a setter call.
 */
bindingset[expr]
predicate mayWriteBackViaSetterCall(Expr expr) {
  any(DataFlowPlugin p).mayWriteBackViaSetterCall(expr)
}
