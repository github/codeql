load("@rules_rust//rust:defs.bzl", "rust_test")
load("//misc/bazel:rust.bzl", "codeql_rust_binary")
load("//misc/bazel/3rdparty/rust_workspace_deps:defs.bzl", "aliases", "all_crate_deps")
load("//unified:platforms.bzl", "UNIFIED_SUPPORTED_PLATFORMS")

exports_files(["Cargo.toml"])

config_setting(
    name = "swift_syntax",
    define_values = {"unified_rust_parser": "false"},
)

_PARSER_FEATURES = select({
    ":swift_syntax": ["swift-syntax"],
    "//conditions:default": ["rust-parser"],
})

_PARSER_DEPS = select({
    ":swift_syntax": ["//unified/swift-syntax-rs:swift_syntax_rs"],
    "//conditions:default": ["//unified/swift-parser"],
})

_PARSER_DATA = select({
    ":swift_syntax": ["//unified/swift-syntax-rs:swift_runtime"],
    "//conditions:default": [],
})

codeql_rust_binary(
    name = "extractor",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = [
        "ast_types.yml",
        "swift_node_types.yml",
    ],
    crate_features = _PARSER_FEATURES,
    data = _PARSER_DATA,
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
    ),
    target_compatible_with = UNIFIED_SUPPORTED_PLATFORMS,
    visibility = ["//visibility:public"],
    deps = all_crate_deps(
        normal = True,
    ) + [
        "//shared/tree-sitter-extractor",
        "//shared/yeast",
    ] + _PARSER_DEPS,
)

_TESTS = {
    "corpus_tests": {
        "data": glob(["tests/corpus/**"]),
        "compile_data": [],
        "size": "medium",
    },
    "location_tests": {
        "data": [],
        "compile_data": [],
        "size": "small",
    },
    # `include_str!`s a checked-in `parse_to_json` dump.
    "swift_syntax_pipeline": {
        "data": [],
        "compile_data": glob(["tests/fixtures/**"]),
        "size": "small",
    },
}

[
    rust_test(
        name = test_name,
        size = spec["size"],
        srcs = ["tests/%s.rs" % test_name] + glob(["src/**/*.rs"]),
        aliases = aliases(),
        compile_data = [
            "ast_types.yml",
            "swift_node_types.yml",
        ] + spec["compile_data"],
        crate_features = _PARSER_FEATURES,
        crate_root = "tests/%s.rs" % test_name,
        data = spec["data"] + _PARSER_DATA,
        edition = "2024",
        proc_macro_deps = all_crate_deps(
            proc_macro = True,
        ),
        rustc_flags = ["--cfg=bazel"],
        target_compatible_with = UNIFIED_SUPPORTED_PLATFORMS,
        deps = all_crate_deps(
            normal = True,
        ) + [
            "//shared/tree-sitter-extractor",
            "//shared/yeast",
        ] + _PARSER_DEPS,
    )
    for test_name, spec in _TESTS.items()
]

test_suite(
    name = "all_tests",
    tests = [":%s" % test_name for test_name in _TESTS],
)
