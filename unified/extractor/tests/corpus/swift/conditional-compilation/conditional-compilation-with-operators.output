  endOfFileToken: endOfFile
  statements:
    codeBlockItem
      item:
        ifConfigDecl
          clauses:
            ifConfigClause
              elements:
                codeBlockItem
                  item:
                    variableDecl
                      attributes:
                      modifiers:
                      bindingSpecifier: let
                      bindings:
                        patternBinding
                          initializer:
                            initializerClause
                              equal: =
                              value:
                                integerLiteralExpr
                                  literal: integerLiteral "1"
                          pattern:
                            identifierPattern
                              identifier: identifier "x"
              condition:
                infixOperatorExpr
                  operator:
                    binaryOperatorExpr
                      operator: binaryOperator "||"
                  leftOperand:
                    tupleExpr
                      leftParen: (
                      rightParen: )
                      elements:
                        labeledExpr
                          expression:
                            infixOperatorExpr
                              operator:
                                binaryOperatorExpr
                                  operator: binaryOperator "&&"
                              leftOperand:
                                declReferenceExpr
                                  baseName: identifier "DEBUG"
                              rightOperand:
                                prefixOperatorExpr
                                  expression:
                                    declReferenceExpr
                                      baseName: identifier "RELEASE"
                                  operator: prefixOperator "!"
                  rightOperand:
                    functionCallExpr
                      leftParen: (
                      rightParen: )
                      arguments:
                        labeledExpr
                          expression:
                            prefixOperatorExpr
                              expression:
                                floatLiteralExpr
                                  literal: floatLiteral "6.0"
                              operator: prefixOperator "<"
                      additionalTrailingClosures:
                      calledExpression:
                        declReferenceExpr
                          baseName: identifier "swift"
              poundKeyword: #if
          poundEndif: #endif

---

top_level source="⟨body⟩"
  body:
    block source="⟨stmt⟩"
      stmt:
        if_expr source="#if ⟨condition⟩\n    ⟨then⟩\n#endif"
          modifier: modifier "conditional_compilation" source=""
          condition:
            binary_expr source="(⟨left⟩) ⟨operator⟩ ⟨right⟩"
              left:
                binary_expr source="⟨left⟩ ⟨operator⟩ ⟨right⟩"
                  left: identifier "DEBUG" source="DEBUG"
                  operator: infix_operator "&&" source="&&"
                  right:
                    unary_expr source="⟨operator⟩⟨operand⟩"
                      operand: identifier "RELEASE" source="RELEASE"
                      operator: prefix_operator "!" source="!"
              operator: infix_operator "||" source="||"
              right:
                call_expr source="⟨callee⟩(⟨argument⟩)"
                  callee: identifier "swift" source="swift"
                  argument:
                    argument source="⟨value⟩"
                      value:
                        unary_expr source="⟨operator⟩⟨operand⟩"
                          operand: float_literal "6.0" source="6.0"
                          operator: prefix_operator "<" source="<"
          then:
            block source="⟨stmt⟩"
              stmt:
                variable_declaration source="⟨modifier⟩ ⟨pattern⟩ = ⟨value⟩"
                  modifier: modifier "let" source="let"
                  pattern: identifier "x" source="x"
                  value: int_literal "1" source="1"
