      item:
        variableDecl
          attributes:
          modifiers:
          bindingSpecifier: let
          bindings:
            patternBinding
              initializer:
                initializerClause
                  equal: =
                  value:
                    ternaryExpr
                      colon: :
                      condition:
                        infixOperatorExpr
                          operator:
                            binaryOperatorExpr
                              operator: binaryOperator ">"
                          leftOperand:
                            declReferenceExpr
                              baseName: identifier "x"
                          rightOperand:
                            integerLiteralExpr
                              literal: integerLiteral "0"
                      questionMark: ?
                      elseExpression:
