                          baseName: identifier "optional"
                  pattern:
                    identifierPattern
                      identifier: identifier "value"
                  bindingSpecifier: let
          elseKeyword: else
          guardKeyword: guard

---

top_level
  body:
    block
      stmt:
        guard_if_stmt
          condition:
            pattern_guard_expr
              pattern:
