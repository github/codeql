guard let value = optional else { return }

---

sourceFile
  endOfFileToken: endOfFile
  statements:
    codeBlockItem
      item:
        guardStmt
          body:
            codeBlock
              leftBrace: {
              rightBrace: }
              statements:
                codeBlockItem
                  item:
                    returnStmt
                      returnKeyword: return
          conditions:
